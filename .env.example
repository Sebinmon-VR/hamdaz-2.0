# ── app ───────────────────────────────────────────────────────────────
ENVIRONMENT=local            # local | production
DEBUG=false

# ── database ──────────────────────────────────────────────────────────
# Azure Postgres requires TLS. URL-encode the password (@ becomes %40).
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres?sslmode=require

# ── Entra ID (Microsoft sign-in) ──────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Must match a Redirect URI on the app registration byte for byte.
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# ── session ───────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false          # must be true in production
# "lax" works when API and frontend share a registrable domain.
# Two different *.azurewebsites.net hosts are cross-site: use "none" + COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# ── frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
