# ══════════════════════════════════════════════════════════════════════
# Hamdaz ERP backend — every setting the app reads.
#
# Copy to .env and fill in. The values here are the development ones; the
# production file overrides the app, session, frontend and database blocks.
# Nothing is left implicit on purpose: a setting that only exists as a
# default is a setting nobody can find when it turns out to be wrong.
# ══════════════════════════════════════════════════════════════════════

# ── app ───────────────────────────────────────────────────────────────
# local | production
ENVIRONMENT=local
# true turns on SQL statement logging. Never in production: customer names
# and prices end up in the log stream.
DEBUG=false

# ── database ──────────────────────────────────────────────────────────
# Azure Postgres requires TLS. URL-encode the password (@ becomes %40).
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres?sslmode=require
# How long a pooled database connection may live, in seconds. Azure's gateway
# cuts idle connections at around five minutes; recycling below that avoids
# the 'server closed the connection unexpectedly' 500 that follows.
DB_POOL_RECYCLE_SECONDS=240

# ── Entra ID (Microsoft sign-in) ──────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Must match a Redirect URI on the app registration byte for byte, or
# sign-in ends on a Microsoft error page rather than in the app.
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
#
# The application permissions the registration needs, all with admin
# consent. They are granted separately, so holding one says nothing about
# holding the next — each endpoint below fails on its own if its permission
# is missing, rather than the app failing to start:
#
#   User.Read.All   the org directory  (/api/v1/directory)
#   Mail.Send       the emails below   (NOTIFY_BY_EMAIL)
#   Calendars.Read  Outlook meetings   (/api/v1/meetings)
#
# Calendars.Read is application-wide: it can open any mailbox in the tenant.
# The meetings module holds that in check by reading only the mailbox on the
# caller's own session and never one named by a request — see
# app/meetings/router.py before adding a route there.

# ── session ───────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs everyone out, which is the right answer to a leak.
SESSION_SECRET=change-me
SESSION_TTL_MINUTES=480
# true in production, so the cookie is never sent in the clear.
COOKIE_SECURE=false
# "lax" holds when the API and the front end share a registrable domain,
# and when they are the same host. Two different *.azurewebsites.net hosts
# are NOT: that domain is on the Public Suffix List, so they count as
# cross-site and need "none" together with COOKIE_SECURE=true. Get this
# wrong and the browser drops the session cookie with no error anywhere.
COOKIE_SAMESITE=lax
# Only for sharing the cookie across sub-domains of one registrable domain
# (".hamdaz.com"). Leave blank otherwise.
COOKIE_DOMAIN=

# ── frontend ──────────────────────────────────────────────────────────
# Where sign-in lands, and the address in every approval email.
FRONTEND_URL=http://localhost:3000
# The exact origins the browser sends, scheme included. Comma-separated.
CORS_ORIGINS=http://localhost:3000

# ── notifications ─────────────────────────────────────────────────────
# Quote approvals, decisions and comments go out by email, through Graph as
# the person who caused them — so the app registration needs the Mail.Send
# application permission with admin consent. false silences all of them,
# which is what a sandbox wants: it mails real colleagues otherwise.
NOTIFY_BY_EMAIL=true

# ── SharePoint (proposals) — read only ────────────────────────────────
SHAREPOINT_SITE_ID=
SHAREPOINT_PROPOSALS_LIST_ID=

# The Proposals list as a person opens it. Every task link is this plus
# the item id: {url}/DispForm.aspx?ID=<id> for the task, and
# {url}/Attachments/<id> for its files. Change it only if the site moves.
SHAREPOINT_PROPOSALS_LIST_URL=https://hamdaz1.sharepoint.com/sites/ProposalTeam/Lists/Proposals

# ── Supplier documents, filed to SharePoint ───────────────────────────
# Both optional: the code carries working defaults and nothing needs setting
# here for the app to run. Present so the destination is findable, and so a
# different deployment can point somewhere else.
#
# The ONE place this app writes a file into Microsoft 365. It is the Documents
# library of the Test site — the same site as the useranalytics list, which is
# the only other thing here that writes. The Proposals list is read only and
# stays that way.
#
# Leave QUOTE_DRIVE_ID blank to switch filing off entirely; uploaded supplier
# quotes then stay in the database, which is the system of record regardless.
# QUOTE_DRIVE_ID=b!sezgUlWA6Um1PgoJ4QTpCULYYroUPQZKvfWrVskCOzPTrTOr4BoOT6QqxrwnoBdN
# QUOTE_DRIVE_FOLDER=attachments2

# ── Zoho Books — read only ────────────────────────────────────────────
# Read for the estimate history behind the win probability, and for the
# profit and loss in the finance module. Never written.
#
# SCOPE. The refresh token needs every scope the code will read with, and a
# scope cannot be added to an existing token — a wider one means generating a
# new refresh token in the Zoho developer console. A token carrying only
# ZohoBooks.estimates.READ drives /quotes and nothing else: the finance module
# will return a statement of zero with every source listed as unreadable.
#
# For quotes alone:
#   ZohoBooks.estimates.READ
#
# For the profit and loss as well — the ledger it is computed from:
#   ZohoBooks.accountants.READ      chart of accounts, manual journals
#   ZohoBooks.invoices.READ         income
#   ZohoBooks.creditnotes.READ      refunds against income
#   ZohoBooks.bills.READ            costs
#   ZohoBooks.vendorcredits.READ    supplier refunds against costs
#   ZohoBooks.expenses.READ         costs paid directly
#   ZohoBooks.settings.READ         base currency, taxes
#
# Omitting any one of these does not break the report — that source is listed
# under integrity.missing and the statement marks itself incomplete — but the
# profit will be wrong by whatever that source carried, so grant all of them.
#
# GET /api/v1/finance/diagnostics reports exactly which endpoints the current
# token can read and which scope each refusal needs. Open that first when a
# figure looks wrong.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# The data centre the refresh token was issued in: .com, .eu, .in, .sa.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# ── Claude (supplier quote extraction) ────────────────────────────────
# console.anthropic.com -> API keys. Nothing else can generate it. Without
# one, supplier quotes can still be typed in by hand and compared.
ANTHROPIC_API_KEY=
# Only for an identity-linked key (the 400 naming 'anthropic-workspace-id').
ANTHROPIC_WORKSPACE_ID=
# Judgement: matching line items across suppliers.
ANTHROPIC_MODEL=claude-opus-5
# Transcription: reading a document. Blank uses ANTHROPIC_MODEL;
# claude-sonnet-5 halves that cost, claude-haiku-4-5 cuts about 75%.
ANTHROPIC_EXTRACT_MODEL=
ANTHROPIC_EXTRACT_EFFORT=medium

# ── OpenAI (the assistant) ──────────────────────────────────────────
# The chat assistant runs on the OpenAI API. Create a key at
# platform.openai.com -> API keys. Which model it uses, who may talk to it
# and what it may do are set by a super admin inside the app, not here.
OPENAI_API_KEY=
# Leave empty for api.openai.com.
OPENAI_BASE_URL=


# ── inbound machine auth ──────────────────────────────────────────────
# Callers send it as: X-API-Key: <value>
# ── careers (the candidate-facing links) ──────────────────────────────
# The origin this API is reached at from outside. Share links for a job
# opening are built from it. Left blank they are built from the request,
# which is right locally and wrong behind a proxy that rewrites the host.
PUBLIC_BASE_URL=
# A separate careers site, if you build one. Set it and the link HR copies
# points there instead of at the page this API serves; that site reads the
# same token through GET /apply/{token}/form. Either way a candidate never
# reaches an ERP URL.
CAREERS_URL=
# Applications accepted per opening from one address per hour. In-process
# and best effort: a brake, not a defence against anything distributed.
APPLICATION_RATE_LIMIT=10

HAMDAZ_API_KEY=
