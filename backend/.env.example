# ── app ───────────────────────────────────────────────────────────────
ENVIRONMENT=local          # local | dev | staging | production
DEBUG=false
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json            # json in deployed envs, console locally

# ── database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://hamdaz:hamdaz@localhost:5432/hamdaz

# ── redis / celery ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── auth (Azure AD / Entra ID) ────────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the placeholder.
JWT_SECRET=change-me-in-production

# The SharePoint sync runs on a schedule with no user present, so it authenticates as the
# application itself (client credentials) rather than borrowing a browser session's token.
# That requires an *application* permission on the app registration, not a delegated one:
#
#     Graph > Application permissions > Sites.Read.All  (+ admin consent)
#
# Without it the sync fails with a 403 from Graph even though sign-in works fine.

# ── SharePoint ────────────────────────────────────────────────────────
# CONSTRAINT C2: live SharePoint is READ ONLY. See docs/PROJECT_PLAN.md §8.1.
# /sites/ProposalTeam and /sites/Test are both LIVE. Despite its name, /sites/Test
# holds production config (superusers, approvers, excludeusers) read on every boot.
SHAREPOINT_DOMAIN=hamdaz1.sharepoint.com
SHAREPOINT_READ_SITES=/sites/ProposalTeam,/sites/Test

# The ONLY writable target in the tenant.
SHAREPOINT_SANDBOX_SITE_PATH=/sites/sandbox
SHAREPOINT_SANDBOX_LIST=sandboxlist

# Leave false unless you are running sandbox integration tests. Even when true,
# writes are confined to the sandbox site by the runtime guard.
SHAREPOINT_SANDBOX_WRITES_ENABLED=false

# ── outbound side effects (§8.2) ──────────────────────────────────────
# false => mail is captured to the email_outbox table instead of being sent.
# A development build must not email a real supplier.
OUTBOUND_EMAIL_ENABLED=false

# ── cors ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
