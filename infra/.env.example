# Copy to infra/.env — docker compose reads it automatically.
# Sign-in does not work until the Azure values are filled in.

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Must match the Redirect URI registered in the Azure app registration exactly.
AZURE_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
